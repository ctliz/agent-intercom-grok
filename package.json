{
  "name": "@ctliz/agent-intercom-grok",
  "version": "0.1.0",
  "description": "Grok Build plugin that exposes Agent Intercom through a packaged MCP launcher.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "agent-intercom-grok-mcp": "bin/agent-intercom-grok-mcp.mjs"
